{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://netscape-resulted-newspapers-dear.trycloudflare.com/api/:match*"
    },
    {
      "source": "/faces/:match*",
      "destination": "https://netscape-resulted-newspapers-dear.trycloudflare.com/faces/:match*"
    },
    {
      "source": "/video_feed",
      "destination": "https://netscape-resulted-newspapers-dear.trycloudflare.com/video_feed"
    },
    {
      "source": "/enrollment_feed",
      "destination": "https://netscape-resulted-newspapers-dear.trycloudflare.com/enrollment_feed"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
